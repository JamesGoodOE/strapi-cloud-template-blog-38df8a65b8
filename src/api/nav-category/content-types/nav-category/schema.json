{
  "kind": "collectionType",
  "collectionName": "nav_categories",
  "info": {
    "singularName": "nav-category",
    "pluralName": "nav-categories",
    "displayName": "Nav Category",
    "description": "Hierarchical navigation categories with permission code mapping"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "label",
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "permission_code": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::permission-code.permission-code"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::nav-category.nav-category",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::nav-category.nav-category",
      "mappedBy": "parent"
    },
    "filter_region": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region"
    },
    "filter_product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "filter_content_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-type-tag.content-type-tag"
    },
    "filter_key_theme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::key-theme.key-theme"
    }
  }
}
