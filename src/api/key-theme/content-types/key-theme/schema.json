{
  "kind": "collectionType",
  "collectionName": "key_themes",
  "info": {
    "singularName": "key-theme",
    "pluralName": "key-themes",
    "displayName": "Key Theme",
    "description": "Topic and theme tags for report categorisation"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::key-theme.key-theme",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::key-theme.key-theme",
      "mappedBy": "parent"
    },
    "reports": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::report.report",
      "mappedBy": "key_themes"
    }
  }
}
