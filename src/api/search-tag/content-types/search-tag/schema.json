{
  "kind": "collectionType",
  "collectionName": "search_tags",
  "info": {
    "singularName": "search-tag",
    "pluralName": "search-tags",
    "displayName": "Search Tag",
    "description": "Free-form search tags for reports"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "reports": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::report.report",
      "mappedBy": "search_tags"
    }
  }
}
