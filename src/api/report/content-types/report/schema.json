{
  "kind": "collectionType",
  "collectionName": "reports",
  "info": {
    "singularName": "report",
    "pluralName": "reports",
    "displayName": "Report",
    "description": "Research publications and analysis documents"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "publication_date": {
      "type": "date",
      "required": true
    },
    "analyst_name": {
      "type": "string"
    },
    "analyst_email": {
      "type": "email"
    },
    "analyst_title": {
      "type": "string"
    },
    "report_status": {
      "type": "enumeration",
      "enum": ["active", "disabled", "private"],
      "default": "active",
      "required": true
    },
    "external_id": {
      "type": "string"
    },
    "view_count": {
      "type": "integer",
      "default": 0
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "documents": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["files"]
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::region.region",
      "inversedBy": "reports"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "reports"
    },
    "content_types": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::content-type-tag.content-type-tag",
      "inversedBy": "reports"
    },
    "key_themes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::key-theme.key-theme",
      "inversedBy": "reports"
    },
    "search_tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::search-tag.search-tag",
      "inversedBy": "reports"
    },
    "analysts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::analyst.analyst",
      "inversedBy": "reports"
    },
    "permission_codes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::permission-code.permission-code",
      "inversedBy": "reports"
    }
  }
}
