{
  "kind": "collectionType",
  "collectionName": "notes",
  "info": {
    "singularName": "note",
    "pluralName": "notes",
    "displayName": "Note",
    "description": "User annotations on report sections"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "note_text": {
      "type": "text",
      "required": true
    },
    "section_anchor": {
      "type": "string",
      "required": true
    },
    "report": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::report.report"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
