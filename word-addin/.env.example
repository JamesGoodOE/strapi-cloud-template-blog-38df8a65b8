# Copy to .env to override build-time configuration.
# These are read by webpack.config.js via DefinePlugin.

# Which AskOE provider to compile against:
#   mock  -> deterministic local sample data, no credentials needed (default in dev)
#   http  -> the real AskOE REST API
ASKOE_PROVIDER=mock

# Base URL of the AskOE API (only used when ASKOE_PROVIDER=http).
# ASKOE_API_BASE=https://api.oxfordeconomics.com/askoe/v1
